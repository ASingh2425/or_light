# Auto detect text files and perform LF normalization on commit
* text=auto eol=lf

# Explicit text file types
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.svg text eol=lf

# Explicit binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.glb binary
*.gltf binary
*.docx binary
*.pdf binary
